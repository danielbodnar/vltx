{
  "name": "@vlt-lab/cf-registry-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that proxies an npm-compatible registry and blocks versions with OSV MAL-* advisories",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test": "vitest run",
    "test:unit": "bun test ./test/unit",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
