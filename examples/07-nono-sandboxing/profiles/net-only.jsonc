// net-only: network allowlist enforcement for an arbitrary command (the `run` phase, used by
// examples/05-network-interception/a-enforce-allowlist). The goal is to make a client that
// ignores the configured registry fail fast instead of silently reaching the public registry.
// Filesystem rules are the nono defaults plus the project and package-manager caches; this
// profile is about egress, not about containing hostile code (use the build profiles for that).
{
  "meta": {
    "name": "vlt-lab-net-only",
    "description": "Arbitrary command with network limited to the registry profile hosts; project read-write; package-manager caches under XDG_CACHE_HOME",
  },

  "workdir": { "access": "readwrite" },

  // Package managers are the usual subjects; npm is in dangerous_commands by default.
  "commands": { "allow": ["npm"] },

  "filesystem": {
    "allow": ["$XDG_CACHE_HOME/npm", "$XDG_CACHE_HOME/pnpm", "$XDG_CACHE_HOME/bun", "$XDG_CACHE_HOME/vlt"],
    "read": ["$XDG_CONFIG_HOME/vlt", "$XDG_DATA_HOME/vlt"],
  },

  "network": {
    // Fail-closed sentinel: with no --allow-domain every host gets 403.
    "allow_domain": ["vlt-lab-no-hosts.invalid"],
  },

  "environment": {
    // Host proxy settings would route clients around nono's proxy; strip them.
    "deny_vars": [
      "npm_config_proxy", "npm_config_https_proxy", "npm_config_http_proxy", "npm_config_noproxy",
      "NPM_CONFIG_PROXY", "NPM_CONFIG_HTTPS_PROXY", "NPM_CONFIG_HTTP_PROXY", "NPM_CONFIG_NOPROXY",
      "YARN_*PROXY*", "GLOBAL_AGENT_*",
    ],
    "set_vars": {
      "npm_config_cache": "$XDG_CACHE_HOME/npm",
      "npm_config_store_dir": "$XDG_CACHE_HOME/pnpm/store",
      "BUN_INSTALL_CACHE_DIR": "$XDG_CACHE_HOME/bun",
      "npm_config_update_notifier": "false",
    },
  },
}
