// native-build: the build phase for npm/pnpm (`npm rebuild`, `pnpm rebuild`), the analogue of
// vlt-build for trees installed by npm-fetch. Lifecycle scripts run here, so the same rules apply:
// no network, no HOME, no tokens, caches isolated per run by sandbox-phase.
{
  "meta": {
    "name": "vlt-lab-native-build",
    "description": "npm/pnpm rebuild: network blocked, project read-write, /tmp writable for native toolchains, tokens stripped, isolated cache",
  },

  "workdir": { "access": "readwrite" },

  // `npm` is the startup command here and sits in dangerous_commands. As with vlt-build, the
  // group does not reach child processes (the scripts), so allowing it changes nothing for them.
  "commands": { "allow": ["npm"] },

  // system_write_linux (/tmp, $TMPDIR) stays included: node-gyp and compilers need scratch space.

  "filesystem": {
    // Points at a per-run directory (sandbox-phase isolates XDG_CACHE_HOME for this phase), so
    // npm's _cacache and logs land somewhere disposable instead of the shared npm cache.
    "allow": ["$XDG_CACHE_HOME/npm"],
  },

  "network": { "block": true },

  "environment": {
    "allow_vars": [
      "PATH", "HOME", "USER", "LOGNAME", "LANG", "LANGUAGE", "LC_*", "TERM", "COLORTERM",
      "NO_COLOR", "FORCE_COLOR", "TZ", "TMPDIR", "XDG_*", "NODE_ENV",
      "npm_config_*", "NPM_CONFIG_*",
    ],
    "deny_vars": [
      "VLT_TOKEN", "VLT_TOKEN_*", "VLT_OTP", "NPM_TOKEN", "NODE_AUTH_TOKEN", "*_authToken*", "*_auth*",
      // Host proxy settings are useless with the network blocked; keep them out of scripts.
      "npm_config_proxy", "npm_config_https_proxy", "npm_config_http_proxy", "npm_config_noproxy",
      "NPM_CONFIG_PROXY", "NPM_CONFIG_HTTPS_PROXY", "NPM_CONFIG_HTTP_PROXY", "NPM_CONFIG_NOPROXY",
    ],
    "set_vars": {
      "npm_config_cache": "$XDG_CACHE_HOME/npm",
      // The registry profiles render npm_config_ignore_scripts=true for the fetch phase; running
      // scripts is the whole point of this phase.
      "npm_config_ignore_scripts": "false",
      // Fail fast instead of retrying a blocked network.
      "npm_config_offline": "true",
      "npm_config_update_notifier": "false",
    },
  },
}
