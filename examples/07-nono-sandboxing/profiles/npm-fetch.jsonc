// npm-fetch: the fetch phase for npm, pnpm and bun, for forks that do not install cleanly with vlt.
// sandbox-phase runs `<tool> install --ignore-scripts`; scripts run later under native-build.
{
  "meta": {
    "name": "vlt-lab-npm-fetch",
    "description": "npm/pnpm/bun install --ignore-scripts: project read-write, tool caches under XDG_CACHE_HOME, network only to registry hosts",
  },

  "workdir": { "access": "readwrite" },

  // `npm` is in the default dangerous_commands group, which blocks it as the startup command.
  "commands": { "allow": ["npm"] },

  "filesystem": {
    // Caches are redirected under $XDG_CACHE_HOME by set_vars below, so no grant touches $HOME
    // (~/.npm, ~/.bun, ~/.local/share/pnpm stay out of reach). sandbox-phase creates them first.
    "allow": ["$XDG_CACHE_HOME/npm", "$XDG_CACHE_HOME/pnpm", "$XDG_CACHE_HOME/bun"],
  },

  "network": {
    // Fail-closed sentinel, see vlt-fetch.jsonc.
    "allow_domain": ["vlt-lab-no-hosts.invalid"],
  },

  // Same connect() rate-limit reason as vlt-fetch; this phase runs only the package manager.
  "linux": { "sandbox_policy": "landlock" },

  "environment": {
    "allow_vars": [
      "PATH", "HOME", "USER", "LOGNAME", "LANG", "LANGUAGE", "LC_*", "TERM", "COLORTERM",
      "NO_COLOR", "FORCE_COLOR", "TZ", "TMPDIR", "XDG_*", "NODE_ENV",
      "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS",
      // Registry config rendered from the registry profile (npm_config_registry, YARN_*, ...)
      "npm_config_*", "NPM_CONFIG_*", "YARN_*", "PNPM_*", "BUN_*",
      // .npmrc files reference ${VLT_TOKEN} for private registries.
      "VLT_TOKEN",
    ],
    // Proxy settings inherited from the host would send the client around nono's proxy (or to a
    // NO_PROXY direct path the sandbox blocks). nono injects its own HTTPS_PROXY after filtering.
    "deny_vars": [
      "npm_config_proxy", "npm_config_https_proxy", "npm_config_http_proxy", "npm_config_noproxy",
      "NPM_CONFIG_PROXY", "NPM_CONFIG_HTTPS_PROXY", "NPM_CONFIG_HTTP_PROXY", "NPM_CONFIG_NOPROXY",
      "YARN_*PROXY*",
    ],
    "set_vars": {
      "npm_config_cache": "$XDG_CACHE_HOME/npm",
      "npm_config_store_dir": "$XDG_CACHE_HOME/pnpm/store",
      "npm_config_cache_dir": "$XDG_CACHE_HOME/pnpm/cache",
      "npm_config_state_dir": "$XDG_CACHE_HOME/pnpm/state",
      "BUN_INSTALL_CACHE_DIR": "$XDG_CACHE_HOME/bun",
      "npm_config_ignore_scripts": "true",
      "npm_config_update_notifier": "false",
    },
  },
}
