// vlt-build (strict): sandbox for `vlt build`, the phase where third-party lifecycle scripts run.
// Assume the code running here is hostile: no network, no HOME, no tokens, no shared caches.
//
// About the inherited `dangerous_commands` groups (rm, cp, mv, chmod, npm, ...): in nono 0.79 they
// only check the command nono starts directly (here `vlt`). Child processes, which is where build
// scripts live, are not checked; nono prints "Child processes can bypass it". So the strict
// profile keeps the default groups, and they neither help nor hurt build scripts. Observed:
// esbuild@0.25.0's postinstall (`node install.js`) builds under this profile unchanged.
{
  "meta": {
    "name": "vlt-lab-vlt-build",
    "description": "vlt build (strict): network blocked, project read-write, no HOME, no /tmp, tokens stripped, isolated cache",
  },

  // Build scripts compile or copy files into their own package dirs inside node_modules.
  "workdir": { "access": "readwrite" },

  "groups": {
    // system_write_linux grants write to /tmp and $TMPDIR. A script could stage payloads there
    // for other processes, so the strict profile removes it and re-adds only the device nodes
    // below. Use vlt-build-permissive for toolchains that need a writable /tmp.
    "exclude": ["system_write_linux"],
  },

  "filesystem": {
    // `vlt build` filters its default target `:scripts:not(:built):not(:malware)` through
    // <cache>/vlt/security-archive.db and writes to it. sandbox-phase points XDG_CACHE_HOME at a
    // per-run directory holding only a copy of that file, so scripts never see the global store
    // (<cache>/vlt/store) or the registry caches, and cannot poison them.
    "allow": ["$XDG_CACHE_HOME/vlt"],
    // User vlt.json only. The keychain under $XDG_DATA_HOME/vlt is deliberately absent.
    "read": ["$XDG_CONFIG_HOME/vlt"],
    // Device nodes and stdio that system_write_linux used to provide.
    "write": [
      "/dev/null", "/dev/zero", "/dev/full", "/dev/tty",
      "/dev/stdout", "/dev/stderr", "/dev/fd", "/dev/pts", "/proc/self/fd",
    ],
  },

  "network": {
    // Linux: static seccomp filter denies all non-Unix sockets (TCP and UDP, so DNS fails too).
    "block": true,
  },

  "environment": {
    // Without an allow-list nono passes every inherited variable to the child, which would hand
    // VLT_TOKEN, GH_TOKEN, AWS_* and friends to every postinstall script.
    "allow_vars": [
      "PATH", "HOME", "USER", "LOGNAME", "LANG", "LANGUAGE", "LC_*", "TERM", "COLORTERM",
      "NO_COLOR", "FORCE_COLOR", "TZ", "TMPDIR", "XDG_*", "VLT_*", "NODE_ENV",
    ],
    // VLT_* stays allowed for registry config, minus every credential vlt reads from the env.
    "deny_vars": ["VLT_TOKEN", "VLT_TOKEN_*", "VLT_OTP"],
  },
}
